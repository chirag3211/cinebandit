{
  "title": "CineBandit \u2014 Live Monitoring",
  "uid": "cinebandit-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Rolling CTR (last 100 feedbacks)",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "cinebandit_rolling_ctr",
          "legendFormat": "CTR"
        }
      ]
    },
    {
      "id": 2,
      "title": "Model Timestep (updates)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "cinebandit_model_timesteps",
          "legendFormat": "Timesteps"
        }
      ]
    },
    {
      "id": 3,
      "title": "Drift Score (KL Divergence)",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "cinebandit_drift_score",
          "legendFormat": "Drift"
        }
      ]
    },
    {
      "id": 4,
      "title": "Arms Seen (unique movies updated)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "cinebandit_arms_seen_total",
          "legendFormat": "Arms"
        }
      ]
    },
    {
      "id": 5,
      "title": "Recommendation Requests/s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "rate(cinebandit_recommendation_requests_total[1m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recommendation Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(cinebandit_recommendation_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(cinebandit_recommendation_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cinebandit_recommendation_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "title": "Feedback Breakdown (likes / dislikes / skips)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "rate(cinebandit_feedback_total{reaction=\"like\"}[5m])",
          "legendFormat": "Likes/s"
        },
        {
          "expr": "rate(cinebandit_feedback_total{reaction=\"dislike\"}[5m])",
          "legendFormat": "Dislikes/s"
        },
        {
          "expr": "rate(cinebandit_feedback_total{reaction=\"skip\"}[5m])",
          "legendFormat": "Skips/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cumulative Reward",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "cinebandit_cumulative_reward_total",
          "legendFormat": "Total Reward"
        }
      ]
    },
    {
      "id": 9,
      "title": "Retraining Activity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "increase(cinebandit_retrain_runs_total[1h])",
          "legendFormat": "Retrain triggers ({{status}}) per hour",
          "refId": "A"
        },
        {
          "expr": "cinebandit_retrain_runs_total",
          "legendFormat": "Total triggers ({{status}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Total Feedback Events",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(cinebandit_feedback_total)",
          "legendFormat": "Total Feedback",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Model Alpha (exploration parameter)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        }
      },
      "targets": [
        {
          "expr": "cinebandit_model_alpha",
          "legendFormat": "Alpha"
        }
      ]
    }
  ]
}